# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Environment variables
.env.local
.env.*.local
!.env.example

# Cursor IDE
.cursor/

# Claude Code — commit project defaults, ignore per-user overrides
.claude/settings.local.json
# Per-machine symlinks regenerated by `npx skills`; actual skill content
# lives in /.agents/skills/ which IS tracked.
.claude/skills/


# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-mcp/

# Local scratch output (scripts write here)
/.tmp/
