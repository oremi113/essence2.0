# =========================
# Supabase
# =========================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — do not expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# =========================
# App
# =========================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================
# ElevenLabs (server-only)
# =========================
# No quotes. No spaces around =. Get key: elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# =========================
# Anthropic (server-only)
# =========================
# Powers the Step 6 hybrid "personalized insert" (Claude Haiku) per MASTER_SPEC
# 8.7.1. Required for /api/messages/generate when the user provides a note; the
# pure-template path works without it. Get key: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# =========================
# Stripe (Session 7b)
# =========================
# Test-mode keys from dashboard.stripe.com → Developers → API keys while in
# Sandbox mode. Publishable key is safe in the browser; secret key is
# server-only and must never be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Webhook signing secret — required once /api/stripe/webhook lands in 7b.
# Local dev: run `stripe listen --forward-to localhost:3100/api/stripe/webhook`
# and copy the whsec_... value it prints. Production: set the production
# webhook's signing secret from the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Price IDs — create Monthly ($12.99) and Annual ($119.00) recurring prices
# under the Voice Vault product in Stripe Dashboard → Products.
STRIPE_PRICE_ID_VAULT_MONTHLY=
STRIPE_PRICE_ID_VAULT_ANNUAL=

# Feature flag — 'true' routes vault checkout through real Stripe. 'false'
# returns a mock checkout URL and keeps the spine guards in mock-walk form.
# S5 go-live: flip to 'true' TOGETHER WITH VOICE_CREATION_REQUIRES_PAYMENT and
# real STRIPE_PRICE_ID_VAULT_* values (and a live STRIPE_SECRET_KEY +
# STRIPE_WEBHOOK_SECRET). All three move as one lever — see docs/session-s5-golive.
VAULT_STRIPE_ENABLED=false

# Feature flag (FOLLOW_UPS #22) — 'true' gates paid voice creation
# (/api/voice-profiles/[id]/start → ElevenLabs) on an active subscription
# ({trial, active}); other statuses get 402. The card-capture-before-processing
# reorder that yields `trial` before /start has landed (spine S1–S3), so this is
# safe to flip at S5 alongside VAULT_STRIPE_ENABLED. Keep OFF until then.
VOICE_CREATION_REQUIRES_PAYMENT=false

# =========================
# Playwright test account (local/dev only — do NOT use in prod)
# =========================
# Test user for automated e2e tests. Playwright signs in via
# signInWithPassword against this account to bypass magic-link auth.
# Bootstrap: create via Supabase admin API with a random password and
# user_metadata.playwright_test = true, then populate these three vars.
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
PLAYWRIGHT_TEST_USER_ID=

# =========================
# Dev-only route gates — local only, NEVER set in production / Vercel
# =========================
# ENABLE_DEV_ROUTES: exposes /dev/* routes (sandboxes, visual review).
#   When unset or !== 'true', the entire /dev segment 404s (see
#   src/app/dev/layout.tsx).
# ENABLE_DEV_AUTH: additionally exposes /dev/test-auth, a credential-
#   accepting endpoint used by Playwright to sign the test account in.
#   Defense in depth: even if ENABLE_DEV_ROUTES is accidentally enabled
#   somewhere it shouldn't be, the credential endpoint requires this
#   second flag. Both must be true for /dev/test-auth to render.
ENABLE_DEV_ROUTES=
ENABLE_DEV_AUTH=

# =========================
# Rate Limits (optional overrides)
# =========================
# RATE_LIMIT_MAX_CLIPS_PER_PROFILE=30
# RATE_LIMIT_MAX_MESSAGES_PER_DAY=20
# RATE_LIMIT_MAX_VOICE_CREATIONS_PER_DAY=5
# RATE_LIMIT_MAX_SIGNED_URLS_PER_MINUTE=30

# =========================
# Internal Testing (do not enable in production)
# =========================
# ENABLE_INTERNAL_DELETE=true
