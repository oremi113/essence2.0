{
  "name": "essence2.0",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-em-dashes.mjs",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/gen-types.mjs --write",
    "check:types": "node scripts/gen-types.mjs --check",
    "followups:build": "node scripts/followups.mjs --build",
    "followups:check": "node scripts/followups.mjs --check",
    "legal:build": "node scripts/legal-build.mjs --build",
    "legal:check": "node scripts/legal-build.mjs --check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test -c playwright.smoke.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^22.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.2",
    "marked": "^18.0.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
